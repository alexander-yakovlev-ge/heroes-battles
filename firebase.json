{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "database": { "rules": "database.rules.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "src", "*.log"]
    }
  ],
  "hosting": {
    "public": "apps/client/dist-web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "database": { "host": "0.0.0.0", "port": 9000 },
    "storage": { "host": "0.0.0.0", "port": 9199 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "hosting": { "host": "0.0.0.0", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
