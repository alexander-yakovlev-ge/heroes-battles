{
  "name": "@hb/assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "tsc -p tsconfig.build.json && node scripts/preview.mjs",
    "bounds": "tsc -p tsconfig.build.json && node scripts/bounds.mjs"
  },
  "dependencies": {
    "@hb/game-core": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
