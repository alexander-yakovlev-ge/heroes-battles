{
  "expo": {
    "name": "Heroes Battles",
    "slug": "heroes-battles",
    "scheme": "heroesbattles",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.heroesbattles.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.heroesbattles.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-localization"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
